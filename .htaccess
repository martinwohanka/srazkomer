# Srážkoměr – nastavení webového serveru (Apache, WEDOS)

# Po první návštěvě přes https prohlížeč používá už jen https
# (zjištění polohy, offline režim a service worker na http nefungují).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Soubory pro vývoj a stav nasazování na web nepatří.
<FilesMatch "^(README\.md|CLAUDE\.md|\.ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
